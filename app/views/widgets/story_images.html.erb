<% if @story_images %>
	<div id="widget" class="widget_column">
		<div class="widget_head">
			<h4>Purchase Photos</h4>
		</div>
		<div class="container">
			<div class="row">
				<% @story_images.each do |image| %>
					<div class="col-12 col-sm-6 col-md-4 col-lg-3">
						<div class="card text-center">
							<div class="widget_panel">
								<%= link_to image_tag(image.image(:large), :class=>"card-img-top card_section_img"),
									story_image_path(image.id)+"?referrer=widget", target: :_blank %>
							</div>
							<div class="card-block">
								<p class="card-text">
									<% if !image.media_webcaption.nil? and !image.media_webcaption.empty? %>
										<i class="modal_image_caption"><%= truncate image.media_webcaption, :length => 80, :separator => /\s/ %></i>
									<% else %>
										<i class="modal_image_caption"><%= truncate image.media_printcaption, :length => 80, :separator => /\s/ %></i>
									<% end %>
								</p>
							</div>
						</div>
					</div>
				<% end %>
			</div>
		</div>

		<div class="text-center">
			<% if params[:story_id] %>
				<%= link_to( "Search archive for photos", story_images_path()+"?referrer=widget", target: :_blank, :class=>"") %>
			<% else %>
				<% if params[:category] %>
					<%= link_to( "Search archive for photos "+params[:category].titleize, 
						story_images_path(:search_query => params[:category])+"?referrer=widget", 
						target: :_blank, :class=>"") %>
				<% else %>
					<% if params[:pubdate] %>
						<%= link_to( "Search archive for photos", 
							story_images_path(:search_query => params[:pubdate])+"?referrer=widget", 
							target: :_blank, :class=>"") %>
					<% else %>
						<%= link_to( "Search archive for photos", story_images_path()+"?referrer=widget", target: :_blank, :class=>"") %>
					<% end %>
				<% end %>
			<% end %>
		</div>

	</div>
<% end %>
