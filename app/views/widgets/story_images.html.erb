<% if @story_images %>
	<div id="widget" class="widget_column">
		<% @story_images.each do |image| %>
<%= image.story_id %><br/>
<%= image.story.categoryname %><%= image.story.subcategoryname %><br/>
<%= image.story.pubdate %><br/>
			<div class="card text-center related_image_card">
				<%= link_to image_tag(image.image(:large), :class=>"card-img-top card_section_img"), story_image_path(image.id) %>
				<div class="card-block">
					<p class="card-text">
						<% if !image.media_webcaption.nil? and !image.media_webcaption.empty? %>
							<i class="modal_image_caption"><%= truncate image.media_webcaption, :length => 60, :separator => /\s/ %></i>
						<% else %>
							<i class="modal_image_caption"><%= truncate image.media_printcaption, :length => 60, :separator => /\s/ %></i>
						<% end %>
					</p>
					<%= link_to( "View", story_image_path(image.id), :class=>"btn btn-primary") %>
				</div>
			</div>
		<% end %>
	</div>
<% end %>
