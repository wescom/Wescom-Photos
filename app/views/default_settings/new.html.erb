<div class="default_heading">
	<div class="container search_container">
		<div class="row justify-content-between">
			<h1>Global Settings</h1>
		</div>
		<h6>These settings control site-wide defaults for the location...</h6>
	</div>

</div>

<div class="default_block" >
	<%= form_for(@default_settings) do |f| %>
		<h5>Location:</h5>
		<div class="form-group row offset-1">
			<%= f.select 'location_id', 
				options_from_collection_for_select(@locations, 'id', 'name', 
				:selected => @default_settings.location_id), 
				{:class => "form-search-select", :prompt => "- Select Location -", :required => true} %>
		</div>

		<div class="form-group row">
			<label for="image_hi_res_price" class="offset-1 col-3 col-form-label">Image Hi-Res Price:</label>
			<div class="col-3">
				<%= f.number_field :image_hi_res_price, class: "form-control", :step => "0.01", :required => "true" %>
			</div>
		</div>
		<div class="form-group row">
			<label for="image_low_res_price" class="offset-1 col-3 col-form-label">Image Low-Res Price:</label>
			<div class="col-3">
				<%= f.number_field :image_low_res_price, class: "form-control", :step => "0.01", :required => "true" %>
			</div>
		</div>
		<div class="form-group row">
			<label for="pdf_price" class="offset-1 col-3 col-form-label">PDF Price:</label>
			<div class="col-3">
				<%= f.number_field :pdf_price, class: "form-control", :step => "0.01", :required => "true" %>
			</div>
		</div>
		<hr/>

		<h5>Orders:</h5>
		<div class="form-group row">
			<label for="image_use_license" class="offset-1 col-3 col-form-label">Image use license:</label>
			<div class="col-8">
				<%= f.text_area :image_use_license, class: "form-control", :placeholder => "", :required => "true" %>
			</div>
		</div>
		<div class="form-group row">
			<label for="confirmation_from_email" class="offset-1 col-3 col-form-label">Confirmation From Email:</label>
			<div class="col-4">
				<%= f.text_field :confirmation_from_email, class: "form-control", :placeholder => "Confirmation from email", :required => "true" %>
			</div>
		</div>
		<hr/>

		<h5>Home page:</h5>
		<div class="form-group row">
			<label for="home_logo" class="offset-1 col-3 col-form-label">Location logo:</label>
			<div class="col-8">
				<%= f.file_field :image %>
			</div>
		</div>
		<div class="form-group row">
			<label for="home_welcome_text" class="offset-1 col-3 col-form-label">Welcome text:</label>
			<div class="col-8">
				<%= f.text_area :home_welcome_text, class: "form-control", :placeholder => "Welcome text for the Home page" %>
			</div>
		</div>
		<div class="form-group row">
			<label for="home_image_cat1" class="offset-1 col-3 col-form-label">
				Image category names:
				<a href="#" data-toggle="tooltip" data-original-title="Title to display for this category on Home Page" data-placement="top">
					<i class="fa fa-info-circle" ></i>
				</a>
			</label>
			<div class="col-2">
				<%= f.text_field :home_image_cat1_name, class: "form-control", :placeholder => "Category 1 name", :required => "true" %>
			</div>
			<div class="col-2">
				<%= f.text_field :home_image_cat2_name, class: "form-control", :placeholder => "Category 2 name", :required => "true" %>
			</div>
			<div class="col-2">
				<%= f.text_field :home_image_cat3_name, class: "form-control", :placeholder => "Category 3 name", :required => "true" %>
			</div>
		</div>
		<div class="form-group row">
			<label for="home_image_cat1" class="offset-1 col-3 col-form-label">
				Image search categories:
				<a href="#" data-toggle="tooltip" data-original-title="Text to search StoryMedia category or Story category/subcategory" data-placement="top">
					<i class="fa fa-info-circle" ></i>
				</a>
			</label>
			<div class="col-2">
				<%= f.text_field :home_image_cat1, class: "form-control", :placeholder => "Category 1 search text", :required => "true" %>
			</div>
			<div class="col-2">
				<%= f.text_field :home_image_cat2, class: "form-control", :placeholder => "Category 2 search text", :required => "true" %>
			</div>
			<div class="col-2">
				<%= f.text_field :home_image_cat3, class: "form-control", :placeholder => "Category 3 search text", :required => "true" %>
			</div>
		</div>
		<div class="form-group row">
			<label for="home_image_cat1_description" class="offset-1 col-3 col-form-label">
				Image search descriptions:
				<a href="#" data-toggle="tooltip" data-original-title="Description to display for this category on Home Page" data-placement="top">
					<i class="fa fa-info-circle" ></i>
				</a>
			</label>
			<div class="col-2">
				<%= f.text_area :home_image_cat1_description, class: "form-control", :placeholder => "Category 1 description text" %>
			</div>
			<div class="col-2">
				<%= f.text_area :home_image_cat2_description, class: "form-control", :placeholder => "Category 2 description text" %>
			</div>
			<div class="col-2">
				<%= f.text_area :home_image_cat3_description, class: "form-control", :placeholder => "Category 3 description text" %>
			</div>
		</div>
		<hr/>

		<h5>Search:</h5>
		<small class="form-text text-muted">Filtering to include on all searches in database.</small>
		<div class="form-group row offset-1">
			<label for="search_for_priority" class="col-3 col-form-label">Include image 'Priority':</label>
			<div class="col-6">
				<%= f.text_field :search_for_priority, class: "form-control", :placeholder => "Priority to filter by" %>
			</div>
		</div>
		<div class="form-group row offset-1">
			<label for="search_for_caption_text" class="col-3 col-form-label">Include image caption text:</label>
			<div class="col-6">
				<%= f.text_field :search_for_caption_text, class: "form-control", :placeholder => "Caption text to to filter by" %>
			</div>
		</div>
		<hr class="form-group row offset-1"/>
		<div class="form-group row offset-1">
			<label for="search_for_pdf_pubdate" class="col-3 col-form-label">PDF pubdate greater than:</label>
			<div class="col-6">
				<div class="input-group date form-search-date" data-provide="datepicker">
					<%= f.text_field :search_for_pdf_pubdate, class: "form-control", :placeholder => "mm/dd/yyyy" %>
					<div class="input-group-addon">
				        <i class='fa fa-calendar'></i>
				    </div>
				</div>
			</div>
		</div>
		<div class="form-group row offset-1">
			<label for="search_for_pdf_pubtypeId" class="col-3 col-form-label">PDF publication type:</label>
			<div class="col-6">
				<%= f.select :search_for_pdf_pubtypeId, @publication_type.collect { |c| [c.name, c.id] }, 
						{:include_blank => "- Choose publication type -", :selected=>''}, 
						:multiple => true, :class => 'form-control' %>
			</div>
		</div>
		<hr/>

		<div class="form-group row d-flex justify-content-end">
			<%= f.submit "Cancel", :name => 'cancel_button', :class => 'btn btn-primary'%>
			<%= f.submit "Update", :class => 'btn btn-primary'%>
		</div>
	<% end %>
</div>