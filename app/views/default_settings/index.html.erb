<div class="default_heading">
	<div class="container search_container">
		<div class="row justify-content-between">
			<h1>Default Settings</h1>
			<div><%= link_to 'Add', new_default_setting_path, :class=>"btn btn-primary btn-small" %></div>
		</div>
		<h6>These settings control site-wide defaults...</h6>
	</div>

</div>

<div class="default_block" >
	<table id="default_settings" class="table table-hover table-condensed">
		<thead>
			<tr>
				<th class="">Active</th>
				<th class="">Id</th>
				<th class="">Location</th>
				<th class=""></th>
				<th class=""></th>
				<th class="text-center">Last Updated</th>
				<th class="action_col text-center"></th>
			</tr>
		</thead>

		<tbody>
			<% if @all_default_settings.size > 0 %>
				<% @all_default_settings.each do |current_default_setting| %>
					<tr>
						<td class="text-center">
							<% if current_default_setting.active %>
								<%= icon('check fa-lg') %>
							<% end %>
						</td>
						<td><%= current_default_setting.id %></td>
						<td class="font-weight-bold"><%= current_default_setting.location.name %></td>
						<td></td>
						<td><%= image_tag(current_default_setting.site_image(:medium), 
								:alt=>current_default_setting.id, 
								:class=>"newspaper_logo") %></td>
						<td class="text-center"><%= current_default_setting.updated_at.strftime('%m/%d/%y') %></td>
						<td class="text-center">
							<p class="btn btn-outline-info">
								<%= link_to '<i class="fa fa-eye"></i>'.html_safe, 
									default_setting_path(current_default_setting),
									title: 'View Settings', 'data-toggle' => 'tooltip', 'data-placement' => 'right' %>
							</p>
						</td>
					</tr>
				<% end %>
			<% else %>
				<tr><td colspan="5">No settings</td></tr>
			<% end %>
		</tbody>
	</table>
<div>
