<div class="default_heading">
	<div class="container search_container">
		<div class="row justify-content-between">
			<h1>Default Settings: <%= @default_settings.location.name %></h1>
		</div>
		<%= link_to 'Back to All Default Settings', default_settings_path, :class=>"float-right" %>
		<h6>These settings control site-wide defaults...</h6>
	</div>

</div>

<div class="default_block" >
	<h5>Banner Images:</h5>
	<div class="form-group row">
		<div class="offset-1">
			<table class="table table-condensed">
				<tbody>
					<tr>
						<td>
							<div class="d-flex flex-wrap justify-content-start align-items-center">
								<% @default_settings.default_banner_images.each do |banner_image| %>
									<div>
										<%= image_tag(banner_image.banner_image(:small), :class=>"img-thumb img-responsive") %>
										<%= link_to icon('remove fa-lg'), 
											default_banner_image_path(:id => banner_image,:current_default_setting=>@default_settings), :class => "",
											:method=> :delete, :action => 'destroy',
											data: {confirm:'Remove image from banner images?'},
											title: 'Delete banner image', 'data-toggle' => 'tooltip', 'data-placement' => 'right' %>
									</div>
								<% end %>
							</div>
								<%= link_to 'Add New', new_default_banner_image_path(:current_default_setting=>@default_settings), :class=>"float-right" %>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</div>
	
<div class="default_block" >
	<h5>Pricing Options:
		<a href="#" data-toggle="tooltip" data-original-title="Define each price option available for this site" data-placement="top">
			<i class="fa fa-info-circle" ></i>
		</a>
	</h5>
	<div class="form-group row">
		<div class="offset-1">
			<table class="table table-hover table-sm">
				<thead>
					<tr>
						<th class="">Active</th>
						<th class="">Item Type</th>
						<th class="">Name</th>
						<th class="">Quality</th>
						<th class="">ToolTip</th>
						<th class="">Description</th>
						<th class="">Price</th>
						<th class="action_col text-center"></th>
						<th class="action_col text-center"></th>
					</tr>
				</thead>
				<tbody>
					<% @default_settings.default_pricing.each do |price| %>
						<tr>
							<td class="text-center">
								<% if price.active %>
									<%= icon('check fa-lg') %>
								<% end %>
							</td>
							<td><%= price.item_type %></td>
							<td><%= price.price_name %></td>
							<td><%= price.price_quality %></td>
							<td><%= price.price_tooltip %></td>
							<td><%= price.price_description %></td>
							<td><%= price.price %></td>
							<td class="text-center">
								<%= link_to icon('edit fa-lg'),
									edit_default_pricing_path(price,:current_default_setting=>@default_settings),
									title: 'Edit', 'data-toggle' => 'tooltip', 'data-placement' => 'right' %>
							</td>
							<td class="text-center">
								<%= link_to icon('remove fa-lg'), 
									default_pricing_path(price), :class => "",
									:method=> :delete, :action => 'destroy',
									data: {confirm:'Remove price option?'},
									title: 'Delete', 'data-toggle' => 'tooltip', 'data-placement' => 'right' %>
							</td>
						</tr>
					<% end %>
					<tr><td colspan="8"><%= link_to 'Add New', new_default_pricing_path(:current_default_setting=>@default_settings), :class=>"float-right" %></td></tr>
				</tbody>
			</table>
		</div>
	</div>
</div>

<div class="default_block" >
	<div class="float-right">
		<%= link_to 'Edit Remaining Defaults', edit_default_setting_path(@default_settings), :class=>"btn btn-primary btn-small" %>
	</div>

	<h5>Logo:</h5>
	<div class="form-group row">
		<div class="offset-1 col-3">
			<%= image_tag(@default_settings.site_image(:medium), :alt=>@default_settings.id, :class=>"newspaper_logo") %>
		</div>
	</div>
	<hr/>

	<h5>Home page:</h5>
	<div class="form-group row">
		<label for="home_welcome_text" class="offset-1 col-3 col-form-label">Welcome text:</label>
		<div class="col-8">
			<%= @default_settings.home_welcome_text %>
		</div>
	</div>
	<div class="form-group row">
		<label for="home_image_cat1" class="offset-1 col-3 col-form-label">
			Image category names:
			<a href="#" data-toggle="tooltip" data-original-title="Title to display for this category on Home Page" data-placement="top">
				<i class="fa fa-info-circle" ></i>
			</a>
		</label>
		<div class="col-2">
			<%= @default_settings.home_image_cat1_name %>
		</div>
		<div class="col-2">
			<%= @default_settings.home_image_cat2_name %>
		</div>
		<div class="col-2">
			<%= @default_settings.home_image_cat3_name %>
		</div>
	</div>
	<div class="form-group row">
		<label for="home_image_cat1" class="offset-1 col-3 col-form-label">
			Image search categories:
			<a href="#" data-toggle="tooltip" data-original-title="Text to search StoryMedia category or Story category/subcategory" data-placement="top">
				<i class="fa fa-info-circle" ></i>
			</a>
		</label>
		<div class="col-2">
			<%= @default_settings.home_image_cat1 %>
		</div>
		<div class="col-2">
			<%= @default_settings.home_image_cat2 %>
		</div>
		<div class="col-2">
			<%= @default_settings.home_image_cat3 %>
		</div>
	</div>
	<div class="form-group row">
		<label for="home_image_cat1_description" class="offset-1 col-3 col-form-label">
			Image search descriptions:
			<a href="#" data-toggle="tooltip" data-original-title="Description to display for this category on Home Page" data-placement="top">
				<i class="fa fa-info-circle" ></i>
			</a>
		</label>
		<div class="col-2">
			<%= @default_settings.home_image_cat1_description %>
		</div>
		<div class="col-2">
			<%= @default_settings.home_image_cat2_description %>
		</div>
		<div class="col-2">
			<%= @default_settings.home_image_cat3_description %>
		</div>
	</div>
	<hr/>

	<h5>Orders:</h5>
	<div class="form-group row">
		<label for="image_use_license" class="offset-1 col-3 col-form-label">Image use license:</label>
		<div class="col-8">
			<%= @default_settings.image_use_license %>
		</div>
	</div>
	<div class="form-group row">
		<label for="confirmation_from_email" class="offset-1 col-3 col-form-label">Confirmation From Email:</label>
		<div class="col-4">
			<%= @default_settings.confirmation_from_email %>
		</div>
	</div>
	<hr/>

	<h5>Search:</h5>
	<small class="form-text text-muted">Filtering to include on all searches in database.</small>
	<div class="form-group row offset-1">
		<label for="search_for_priority" class="col-3 col-form-label">Include image 'Priority':</label>
		<div class="col-6">
			<%= @default_settings.search_for_priority %>
		</div>
	</div>
	<div class="form-group row offset-1">
		<label for="search_for_caption_text" class="col-3 col-form-label">Include image caption text:</label>
		<div class="col-6">
			<%= @default_settings.search_for_caption_text %>
		</div>
	</div>
	<hr class="form-group row offset-1"/>
	<div class="form-group row offset-1">
		<label for="search_for_pdf_pubdate" class="col-3 col-form-label">PDF pubdate greater than:</label>
		<div class="col-6">
			<div class="input-group date form-search-date" data-provide="datepicker">
				<%= @default_settings.search_for_pdf_pubdate %>
			</div>
		</div>
	</div>
	<div class="form-group row offset-1">
		<label for="search_for_pdf_pubtypeId" class="col-3 col-form-label">PDF publication types:</label>
		<div class="col-6">
			<%= @default_settings.search_for_pdf_pubtypeId %>
		</div>
	</div>
	<hr/>

</div>