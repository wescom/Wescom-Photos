<div class="admin_heading">
	<div class="container search_container">
		<div class="row justify-content-between">
			<h1>Global Settings</h1>
			<div><%= link_to 'Edit', edit_admin_order_path(@setting), :class=>"btn btn-primary btn-small" %></div>
		</div>
		<h6>These settings control site-wide settings...</h6>
	</div>

</div>

<% if !flash[:notice].blank? %>
	<div class="alert alert-success">
		<%= flash[:notice] %>
	</div>
<% end %>

<div class="admin_block" >
	<h5>Pricing:</h5>
	<% @settings.each do |f| %>
		<div class="form-group row">
			<label for="image_price" class="col-3 col-form-label">Image Price:</label>
			<div class="col-3">
				<%= number_to_currency(f.image_price) %>
			</div>
		</div>
		<div class="form-group row">
			<label for="image_price" class="col-3 col-form-label">PDF Price:</label>
			<div class="col-3">
				<%= number_to_currency(f.pdf_price) %>
			</div>
		</div>
		<div class="form-group row">
			<label for="image_price" class="col-3 col-form-label">Confirmation From Email:</label>
			<div class="col-4">
				<%= f.confirmation_from_email %>
			</div>
		</div>
	<% end %>
</div>