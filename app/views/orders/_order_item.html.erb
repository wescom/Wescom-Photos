<tr>
	<td data-th="Image" class="image_column text-center">
		<% if order_item.item_type == "StoryImage" %>
			<%= link_to image_tag(order_item.story_image.image(:large), :alt=>"Story Image", :class=>"img-thumb img-responsive"), 				order_order_item_download_path(@order.obscure_uniq_identifier,order_item.story_image),
				:title => 'Download Image', :rel => 'tooltip', "data-placement" => "Right" %>
		<% else %>
			<%= link_to image_tag(order_item.pdf_image.image(:large), :alt=>"PDF Image", :class=>"img-thumb img-responsive"), 				order_order_item_download_path(@order.obscure_uniq_identifier,order_item.pdf_image),
				title: 'Download PDF', :rel => 'tooltip', "data-placement" => "Right" %>
		<% end %>
	</td>
	<td data-th="Description" class="description_column text-center">
		<div class="align-top"><%= order_item.item_description %></div>
	</td>
	<td data-th="Published" class="publish_column text-center d-none d-sm-block">
		<% if order_item.item_type == "StoryImage" %>
			<% if order_item.story_image.story %>
				<% if order_item.story_image.story.plan %>
					<%= order_item.story_image.story.plan.pub_name unless order_item.story_image.story.plan.pub_name.nil? %>
					- <%= order_item.story_image.story.pubdate.strftime('%m/%d/%y') unless order_item.story_image.story.pubdate.nil? %>
				<% end %>
			<% end %>
		<% else %>
			<% if order_item.pdf_image.plan %>
				<%= order_item.pdf_image.publication %><br/> 
				<%= order_item.pdf_image.pubdate.strftime('%m/%d/%y') unless order_item.pdf_image.pubdate.nil? %><br/> 
				<%= order_item.pdf_image.section_letter %><%= order_item.pdf_image.page %>
			<% end %>
		<% end %>
	</td>
	<td data-th="Price" class="price_column text-center">
		<div class="align-top"><%= number_to_currency(order_item.price_cents.to_d/100) %></div>
	</td>
	<td data-th="Action" class="action_column text-center">
		<% if order_item.item_type == "StoryImage" %>
			<%= link_to icon('download fa-lg'), order_order_item_download_path(@order.obscure_uniq_identifier,order_item.story_image),
				:title => 'Download Image', :rel => 'tooltip', "data-placement" => "Right" %>
		<% else %>
			<%= link_to icon('download fa-lg'), order_order_item_download_path(@order.obscure_uniq_identifier,order_item.pdf_image),
				title: 'Download PDF', :rel => 'tooltip', "data-placement" => "Right" %>
		<% end %>
	</td>
</tr>
