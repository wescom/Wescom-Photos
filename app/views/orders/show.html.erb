<div class="order_heading">
	<h1>Order
		<% if @order.nil? %>
			not found 
		<% else %>
			#<%= @order.id %>
		<% end >%>
	</h1>
</div>

<div class="container">
	<div class="row order_block">
		<% if @order %>
			<table id="order" class="table table-hover table-condensed">
				<thead>
					<tr>
						<th class="image_column text-center">Item</th>
						<th class="description_column text-center">Description</th>
						<th class="publish_column text-center d-none d-sm-block">Published</th>
						<th class="price_column text-center">Price</th>
						<th class="action_column text-center"></th>
					</tr>
				</thead>

				<tbody>
					<%= render :partial => 'order_item', :collection => @order.order_items, object: @order %>
				</tbody>

				<tfoot>
					<tr>
						<td colspan="2"></td>
						<td class=""><strong>Total:</strong></td>
						<td class="text-center"><strong><%= number_to_currency @order.amount %></strong></td>
						<td colspan="1"></td>
					</tr>
				</tfoot>
			</table>
			<div>
				Order emailed to: <%= @order.email %>
				<% if admin? %>
					<br/><%= link_to 'Re-Send email', order_resend_order_email_path(@order.id), class: "btn btn-success btn-sm" %>
				<% end %>
			</div>
		<% end %>
	</div>

	<div class="row justify-content-center">
		<div class="col col-sm-2">
			<%= link_to('<i class="fa fa-angle-left"></i> Continue Shopping'.html_safe, 
				session[:referrer], :class=>"btn btn-success btn-small") %>
		</div>
	</div>
</div>