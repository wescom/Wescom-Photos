<div class="cart_heading">
	<h1>Order #<%= @order.id %></h1>
</div>

<% if @order.errors.any? %>
  <div class="alert alert-danger">
    <ul>
      <% @order.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="container">
	<div class="row">
		<table id="order" class="table table-hover table-condensed">
			<thead>
				<tr>
					<th class="image_column text-center">Image</th>
					<th class="publish_column text-center">Published</th>
					<th class="price_column text-center">Price</th>
					<th class="action_column" ></th>
				</tr>
			</thead>

			<tbody>
				<%= render :partial => 'order_item', :collection => @order.order_items %>
			</tbody>

			<tfoot>
				<tr>
					<td colspan="1"></td>
					<td class="float-right"><strong>Total:</strong></td>
					<td class="text-center"><strong><%= number_to_currency @order.amount %></strong></td>
				</tr>
			</tfoot>
		</table>
	</div>

	<div class="row justify-content-between">
		<div class="col col-sm-2">
			<%= link_to('<i class="fa fa-angle-left"></i> Continue Shopping'.html_safe, 
				session[:referrer], :class=>"btn btn-success btn-small") %>
		</div>
		<div class="col col-sm-1 colspan_column"></div>
		<div class="col col-sm-2">

		</div>
	</div>
</div>