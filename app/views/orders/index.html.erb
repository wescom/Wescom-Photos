<div class="orders_heading">
	<div class="orders-search">        
		<%= render :partial => 'search_orders' %>
	</div>
</div>

<div class="orders_block" >
	<table id="order" class="table table-hover table-condensed">
		<thead>
			<tr>
				<th class="text-center">Location</th>
				<th class="text-center">OrderId</th>
				<th class="text-center">Date</th>
				<th class="">Name</th>
				<th class="text-center">Items</th>
				<th class="text-center">Total Amount</th>
				<th class="action_col text-center"></th>
			</tr>
		</thead>

        <tfoot>
          <tr>
            <td colspan="5"></td>
            <td class="text-center"><%= number_to_currency(@orders.sum(:amount)) %></td>
			<td></td>
          </tr>
        </tfoot>

		<tbody>
			<% if @orders.size > 0 %>
				<% @orders.each do |order| %>
					<tr>
						<td class="text-center"><%= order.location.name if order.location %></td>
						<td class="text-center"><%= order.id %></td>
						<td class="text-center"><%= order.created_at.in_time_zone("Pacific Time (US & Canada)").strftime('%m/%d/%y - %l:%M %P') %></td>
						<td><%= order.first_name %> <%= order.last_name %></td>
						<td class="text-center"><%= order.order_items.count %></td>
						<td class="text-center"><%= number_to_currency order.amount %></td>
						<td class="action_column text-center">
							<% if order.order_items.count > 0 %>
								<p class="show_order_items_next btn btn-outline-info">
									<i class="fa fa-file-image-o"></i>
								</p>
								<p class="btn btn-outline-info">
									<%= link_to '<i class="fa fa-shopping-cart"></i>'.html_safe, 
										order_path(order.obscure_uniq_identifier) %>
								</p>
							<% end %>
						</td>
					</tr>
					<tr class="order_items">
						<td class="colspan_column"/>
						<td colspan="5">
							<div class="row">
								<% order.order_items.each do |item| %>
									<div class="text-center">
										<% if item.item_type == "StoryImage" && !item.story_image.nil? %>
											<div class="col text-center">
												<%= image_tag(item.story_image.image(:large), :alt=>"Story Image", :class=>"img-thumb img-responsive") %>
											</div>
										<% else %>
											<% if !item.pdf_image.nil? %>
												<div class="col text-center">
													<%= image_tag(item.pdf_image.image(:large), :alt=>"Story Image", :class=>"img-thumb img-responsive") %>
												</div>
											<% end %>
										<% end %>
										<div class="col text-center">Cost: <%= number_to_currency(item.quantity * item.price_cents.to_d/100) %></div>
										<% if item.item_type == "StoryImage" %>
											<%= link_to icon('download fa-lg'), order_admin_download_path(item.story_image,:item_type=>"StoryImage") %>
										<% else %>
											<%= link_to icon('download fa-lg'), order_admin_download_path(item.pdf_image,:item_type=>"PdfImage") %>
										<% end %>
									</div>
								<% end %>
							</div>
						</td>
					</tr>
					<tr class="mobile_action_row">
						<td colspan="6 justify-flex-end">
							<% if order.order_items.count > 0 %>
								<p class="show_order_items_prev btn btn-outline-info">
									<i class="fa fa-file-image-o"></i>
								</p>
								<p class="btn btn-outline-info">
									<%= link_to '<i class="fa fa-shopping-cart"></i>'.html_safe, 
										order_path(order.obscure_uniq_identifier) %>
								</p>
							<% end %>
						</td>
					</tr>
				<% end %>
			<% else %>
				<tr><td colspan="5">No orders</td></tr>
			<% end %>
		</tbody>
	</table>
	<div class="container search_container">
		<div class="row justify-content-between">
			<div>
				<%= link_to "Email Last month's Orders", email_previous_month_orders_path, class: "btn btn-primary btn-sm" %>
			</div>
			<div>
				<!-- <%= link_to "New Manual Payment", new_order_path, class: "btn btn-primary" %> -->
			</div>
			<div class="flickr_pagination d-none d-sm-block">
				<%= will_paginate @order, :inner_window => 2, :outer_window => 0 %>
			</div>
			<div class="flickr_pagination d-block d-sm-none">
				<%= will_paginate @order, :inner_window => 2, :outer_window => 0, :page_links => false %>
			</div>
		</div>
	</div>
<div>

