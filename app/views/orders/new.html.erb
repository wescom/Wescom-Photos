<div class="checkout_heading">
	<h1>Checkout</h1>
</div>

<div class="container">
   	<% if @order.errors.any? %>
      <div class="alert alert-danger">
        <ul>
          <% @order.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div id="checkout_form" class="form-horizontal">
		<%= form_for @order, url: {action: "create"}, :method => :POST do |f| %>
	        <div class="form-group row">
				<%= f.label :name, 'Name', class: "col-sm-2 col-md-2 col-form-label" %>
		        <div class="col-sm-4 col-md-3">
					<%= f.text_field :first_name, class: "form-control", :placeholder => "First Name", :required => "true" %>
				</div>
		        <div class="col-sm-6 col-md-5">
					<%= f.text_field :last_name, class: "form-control", :placeholder => "Last Name", :required => "true" %>
				</div>
	        </div>

	        <div class="form-group row">
				<%= f.label :card_number, 'Card number', class: "col-sm-2 col-md-2 col-form-label" %>
		        <div class="col-sm-6 col-md-5">
					<%= f.text_field :credit_card_number, class: "form-control", :placeholder => "Credit/Debit Card Number", :required => "true" %>
				</div>
		        <div class="col-sm-4 col-md-4">
					<i class="fa fa-3x fa-cc-visa visa"></i> 
					<i class="fa fa-3x fa-cc-amex amex"> </i> 
					<i class="fa fa-3x fa-cc-discover discover"></i> 
					<i class="fa fa-3x fa-cc-mastercard mastercard"></i>
				</div>
	        </div>
	        <div class="form-group row">
				<%= f.label :expiration_date, 'Expire date', class: "col-sm-2 col-md-2 col-form-label" %>
		        <div class="col-sm-2 col-md-2">
					<%= f.select :expiration_month, months, {}, class: "form-control" %> 
				</div>/
				<div class="col-sm-3 col-md-3">
					<%= f.select :expiration_year, years, {}, class: "form-control" %>
				</div>
	        </div>
	        <div class="form-group row">
				<%= f.label :cvc, 'CVC', class: "col-sm-2 col-md-2 control-label" %>
		        <div class="col-sm-3 col-md-2">
					<%= f.text_field :card_security_code, class: "form-control", :placeholder => "CVC #", :required => "true" %>
				</div>
	        </div>
			<div class="form-group row">
				<label class="col-sm-2">Agree to license? </label>
				<div class="col-sm-5">
					<div class="form-check">
						<label class="form-check-label">
							<input class="form-check-input" type="checkbox" required="true"	>
						</label>
						<a data-toggle="modal" href="#licenseModal" class="">View image use license</a>
					</div>
				</div>
			</div>
			
			<br/>
	        <div class="form-group row">
				<%= f.label :name, 'Email order confirmation to: ', class: "col-sm-2 col-md-3 col-form-label" %>
		        <div class="col-sm-4 col-md-6">
					<%= f.email_field :email, class: "form-control", :placeholder => "Email Address" %>
					<small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>
				</div>
	        </div>
			
	        <div class="form-group row float-right">
				<div class="">
					<%= button_tag(type: "submit", class: "btn btn-primary") do %>
					    <i class="fa fa-lock"></i> Pay <%= number_to_currency(cart_total_amount) %>
					<% end %>
				</div>
			</div>
		<% end %>
	</div>
</div>

<div class="modal fade modal-md" id="licenseModal" tabindex="-1" role="dialog" aria-labelledby="licenseModalLabel" aria-hidden="true">
	<div class="modal-dialog ">
		<div class="modal-content">
			<div class="modal-header">
				<h4 class="modal-title">
					Image Use License
				</h4>
				<button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
			</div>
			<div class="modal-body">
				<div class="container">
					<div class="row">
						<p><%= @default_settings.image_use_license %></p>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<div class="container">
					<div class="image_copyright text-center"> 
						&copy; Copyright - Western Communications, Inc.
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
