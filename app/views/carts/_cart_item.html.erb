<tr>
	<td data-th="Image" class="image_column text-center">
		<%= image_tag(cart_item.item.image(:large), :alt=>"Story Image", :class=>"img-thumb img-responsive") %>
	</td>
	<td data-th="Description" class="description_column text-center">
		<div class="align-top"><%= cart_item.item_description %></div>
	</td>
	<td data-th="Published" class="publish_column text-center d-none d-sm-block">
		<% if cart_item.item_type == "StoryImage" %>
			<% if cart_item.item.story %>
				<% if cart_item.item.story.plan %>
					<%= cart_item.item.story.plan.pub_name unless cart_item.item.story.plan.pub_name.nil? %>
					- <%= cart_item.item.story.pubdate.strftime('%m/%d/%y') unless cart_item.item.story.pubdate.nil? %>
				<% end %>
			<% end %>
		<% else %>
			<% if cart_item.item.plan %>
				<%= cart_item.item.publication %><br/> 
				<%= cart_item.item.pubdate.strftime('%m/%d/%y') unless cart_item.item.pubdate.nil? %><br/> 
				<%= cart_item.item.section_letter if cart_item.item.plan.publication_type.name = 'Editorial' %><%= cart_item.item.page %>
			<% end %>
		<% end %>
	</td>
	<td data-th="Price" class="price_column text-center">
		<div class="align-top"><%= number_to_currency(cart_item.price_cents.to_d/100) %></div>
		<div class="mobile_action_row">
			<%= link_to "Remove", 
				remove_item_cart_path(:id => cart_item.item_id), :method=> :put, :action => 'remove_item_cart',
				data: {confirm:'Remove image from cart?'} %>
		</div>
	</td>
	<td data-th="Action" class="action_column d-none d-sm-block">
		<%= link_to icon('remove fa-lg'), 
			remove_item_cart_path(:id => cart_item.item_id), :method=> :put, :action => 'remove_item_cart',
			data: {confirm:'Remove image from cart?'} %>
	</td>
</tr>
