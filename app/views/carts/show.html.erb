<h1>My Cart</h1>

<div class="container">
	<table id="cart" class="table table-hover table-condensed">
		<thead>
			<tr>
				<th style="width:20%" class="text-center">Image</th>
				<th style="width:20%" class="text-center">Published</th>
				<th style="width:20%" class="text-center">Price</th>
				<th style="width:20%" class="text-center">Cost</th>
				<th style="width:20%"></th>
			</tr>
		</thead>

		<tbody>
			<% if cart_quantity.to_i > 0 %>
				<%= render :partial => 'cart_item', :collection => @cart.cart_items %>
			<% else %>
				<tr><td class="text-center">No images in cart</td></tr>
			<% end %>
		</tbody>

		<tfoot>
			<tr>
				<td><%= link_to('<i class="fa fa-angle-left"></i> Continue Shopping'.html_safe, 
						session[:referrer], :class=>"btn btn-success btn-small") %>
				</td>
				<td colspan="2"></td>
				<td class="text-center">
					<strong>Total <%= number_to_currency @cart.total %></strong>
				</td>
				<td>
					<% if cart_quantity.to_i > 0 %>
						<%= link_to 'Checkout <i class="fa fa-angle-right"></i>'.html_safe, new_order_path, 
									{:class=>"btn btn-success btn-small" } %>
					<% end %>
				</td>
			</tr>
		</tfoot>
	</table>
</div>
