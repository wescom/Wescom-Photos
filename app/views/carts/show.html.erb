<div class="cart_heading">
	<h1>My Cart</h1>
</div>

<% if !flash[:notice].blank? %>
	<div class="alert alert-success">
		<%= flash[:notice] %>
	</div>
<% end %>

<div class="container">
	<div class="row">
		<table id="cart" class="table table-hover table-condensed">
			<thead>
				<tr>
					<th class="image_column text-center">Image</th>
					<th class="publish_column text-center">Published</th>
					<th class="price_column text-center">Price</th>
					<th class="action_column" ></th>
				</tr>
			</thead>

			<tbody>
				<% if cart_quantity.to_i > 0 %>
					<%= render :partial => 'cart_item', :collection => @cart.cart_items %>
				<% else %>
					<tr><td class="text-center">No images in cart</td></tr>
				<% end %>
			</tbody>

			<tfoot>
				<tr>
					<td colspan="1"></td>
					<td class="float-right"><strong>Total:</strong></td>
					<td class="text-center"><strong><%= number_to_currency @cart.total %></strong></td>
				</tr>
			</tfoot>
		</table>
	</div>

	<div class="row justify-content-between">
		<div class="col col-sm-2">
			<%= link_to('<i class="fa fa-angle-left"></i> Continue Shopping'.html_safe, 
				session[:referrer], :class=>"btn btn-success btn-small") %>
		</div>
		<div class="col col-sm-1 colspan_column"></div>
		<div class="col col-sm-2">
			<% if cart_quantity.to_i > 0 %>
				<%= link_to 'Checkout <i class="fa fa-angle-right"></i>'.html_safe, new_order_path, 
					{:class=>"btn btn-success btn-small" } %>
			<% end %>
		</div>
	</div>
</div>