<div class="default_heading">
	<div class="container search_container">
		<div class="row justify-content-between">
			<h1>Edit Price Option for <%= @default_setting.location.name %></h1>
		</div>
	</div>

</div>

<div class="default_block" >
	<%= form_for @default_pricing do |f| %>
		<%= f.hidden_field :default_setting_id, :value => @default_setting.id %>
		<div class="form-group row">
			<label for="active" class="offset-1 col-3 col-form-label">Active?</label>
			<div class="col-3">
				<%= f.check_box :active, class: "form-control" %>
			</div>
		</div>
		<div class="form-group row">
			<label for="item_type" class="offset-1 col-3 col-form-label">Item Type:</label>
			<div class="col-3">
				<%= f.select :item_type, options_for_select(DefaultPricing::ITEM_TYPE_OPTIONS, :selected=>@default_pricing.item_type), {:required => "true"} %>
			</div>
		</div>
		<div class="form-group row">
			<label for="price_name" class="offset-1 col-3 col-form-label">Name:</label>
			<div class="col-3">
				<%= f.text_field :price_name, class: "form-control", :placeholder => "ie. High Resolution, Low Resolution", :required => "true" %>
			</div>
		</div>
		<div class="form-group row">
			<label for="price_quality" class="offset-1 col-3 col-form-label">Quality:</label>
			<div class="col-3">
				<%= f.select :price_quality, options_for_select(DefaultPricing::PRICE_QUALITY_OPTIONS, :selected=>@default_pricing.price_quality), {:required => "true"} %>
			</div>
		</div>
		<div class="form-group row">
			<label for="price_tooltip" class="offset-1 col-3 col-form-label">ToolTip:</label>
			<div class="col-3">
				<%= f.text_field :price_tooltip, class: "form-control", :placeholder => "ToolTip text to display with price" %>
			</div>
		</div>
		<div class="form-group row">
			<label for="price_description" class="offset-1 col-3 col-form-label">Description:</label>
			<div class="col-3">
				<%= f.text_area :price_description, :placeholder => "Description to show on orders", class: "form-control" %>
			</div>
		</div>
		<div class="form-group row">
			<label for="price" class="offset-1 col-3 col-form-label">Price:</label>
			<div class="col-3">
				<%= f.number_field :price, class: "form-control", :placeholder => "", :step => "0.01", :required => "true" %>
			</div>
		</div>
	
		<div class="form-group row d-flex justify-content-end">
			<%= f.submit "Cancel", :name => 'cancel_button', :class => 'btn btn-primary'%>
			<%= f.submit "Update", :class => 'btn btn-primary'%>
		</div>
	
	<% end %>
</div>
