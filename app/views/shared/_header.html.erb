<div id="header_bar" class="d-flex justify-content-between bg-dark">
	<div class="align-items-center">
		<div id="branding">
			<h1>
				<%= link_to root_path do %>
					Wescom <span>Photos</span>
				<% end %>
			</h1>
			<% if !@default_settings.nil? %>
				<%= link_to image_tag(@default_settings.site_image(:medium), :alt=>"newspaper_logo", :class=>"newspaper_logo"), 
					root_path unless @default_settings.respond_to? :each %>
			<% end %>
		</div>
	</div>
	<div class="d-flex align-items-center">
		<% if !current_location.nil? %>
			<div class="btn-group-vertical">
				<div class="btn-block text-center">
					<%= link_to( cart_label_quantity_items(), cart_path(), :class=>"btn btn-success d-none d-sm-block") %>
					<%= link_to( cart_label_quantity(), cart_path(), :class=>"btn btn-success d-block d-sm-none") %>
				</div>
				<% if admin? %>
					<div class="dropleft btn-block text-center">
						<button type="button" class="btn btn-secondary" data-toggle="dropdown">
							<%= icon('bars fa-lg') %>
						</button>
						<div class="dropdown-menu">
							<%= link_to "Dashboard", dashboard_path, :class=>"dropdown-item" %></a>
							<%= link_to "Orders", orders_path, :class=>"dropdown-item" %></a>
							<%= link_to "Locations", locations_path, :class=>"dropdown-item" %></a>
							<%= link_to "Default Settings", default_settings_path, :class=>"dropdown-item" %></a>
							<%= link_to "Default Pages", default_pages_path, :class=>"dropdown-item" %></a>
							<div class="dropdown-divider"></div>
							<%= link_to "Logout", logout_path, :class=>"dropdown-item" %></a>
						</div>
					</div>
				<% end %>
			</div>
		<% end %>
	</div>
</div>
