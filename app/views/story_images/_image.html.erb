<% if image.image.url != "/images/no-image.jpg"%>
	<div class="col-xs-12 col-sm-6 col-md-4 col-lg-4 ">
		<div class="image_gallery_panel">
			<div class="crop">
				<% if !image.media_webcaption.nil? && image.media_webcaption.length > 1 %>
					<%= link_to image_tag(image.image(:large), :alt=>image.media_webcaption.truncate_words(16), :id=>"#{image.id}", :class=>""), 
						story_image_path(image.id), { 
						:remote => true, 'data-toggle' =>  "modal", 
						'data-target' => "#imageGalleryModal#{image.id}", 
						'data-type' => "html" } %>
				<% else %>
					<%= link_to image_tag(image.image(:large), :alt=>"", :id=>"#{image.id}", :class=>""), 
						story_image_path(image.id), { 
						:remote => true, 'data-toggle' =>  "modal", 
						'data-target' => "#imageGalleryModal#{image.id}", 
						'data-type' => "html" } %>
				<% end %>
				<%= link_to "<i class='fa fa-copyright'> </i>".html_safe + " Copyright - The Bulletin/EO Media Group", 
					story_image_path(image.id), { 
					:class => "watermark",
					:remote => true, 'data-toggle' =>  "modal", 
					'data-target' => "#imageGalleryModal#{image.id}", 
					'data-type' => "html" } %>
			</div>

			<div class="image_gallery_caption">
				<% if !image.media_printcaption.nil? %>
					<%= image.media_printcaption %>
				<% end %>
			</div>
			<div class="image_gallery_hover_bar">
				<span class="bar_pub_info">
					<% if image.story %>
						<% if image.story.plan %>
							<%= image.story.plan.pub_name unless image.story.plan.pub_name.nil? %>
							- <%= image.story.pubdate.strftime('%m/%d/%y') unless image.story.pubdate.nil? %>
						<% end %>
					<% end %>
				</span>
				<span class="bar_icons float-right">
					<% if admin? %>
						<%= link_to '<i class="fa fa-download"> </i>'.html_safe, 
							order_admin_download_path(image,:item_type=>"StoryImage"),
							:class => "btn btn-sm btn-primary",
							title: 'Admin Download HiRes', 'data-toggle' => 'tooltip', 'data-placement' => 'top' %>
					<% end %>
					<%= link_to "<i class='fa fa-info'> </i>".html_safe, story_image_path(image.id), { 
						:class => "btn btn-sm btn-success",
						:remote => true, 'data-toggle' =>  "modal", 
						'data-target' => "#imageGalleryModal#{image.id}", 
						'data-type' => "html" } %>
				</span>
			</div>
		</div>
	</div>
<% end %>


<div class="modal fade" id="imageGalleryModal<%= image.id %>" tabindex="-1" role="dialog" aria-labelledby="gridSystemModalLabel" aria-hidden="true">
	<div class="modal-dialog ">
		<div class="modal-content">
			<div class="modal-header">
				<h4 class="modal-title">
					<% if image.story %>
						<% if image.story.plan %>
							<%= image.story.plan.pub_name unless image.story.plan.pub_name.nil? %>
							- <%= image.story.pubdate.strftime('%m/%d/%y') unless image.story.pubdate.nil? %>
							<% if !image.story.hl1.nil? and image.story.hl1.length > 1 %>
								<%= "- " + image.story.hl1 %>
							<% end %>
						<% else %>
							<%= image.story.hl1 unless image.story.hl1.nil? %>
						<% end %>
					<% end %>
				</h4>
				<button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
			</div>
			<div class="modal-body">
				<div class="container">
					<div class="row">
						<div class="col-xs-12 col-sm-12 col-md-12 col-lg-8">
							<div class="modal_image2">
								<% if !image.media_webcaption.nil? && image.media_webcaption.length > 1 %>
									<%= image_tag(image.image(:large), :alt=>image.media_webcaption.truncate_words(16), :class=>"") %>
								<% else %>
									<%= image_tag(image.image(:large), :alt=>"", :class=>"") %>
								<% end %>
								<div class="watermark">&copy; Copyright - The Bulletin/EO Media Group</div>
							</div>
						</div>
						<div class="col-xs-12 col-sm-12 col-md-12 col-lg-4">
							<% if !image.media_webcaption.nil? && image.media_webcaption.length > 1 %>
								<div class="modal_image_caption">
									<h6>Web Caption:</h6>
									<p><i><%= image.media_webcaption %></i></p>
								</div>
							<% end %>
							<% if !image.media_printcaption.nil? && image.media_printcaption.length > 1 %>
								<div class="modal_image_caption">
									<h6>Print Caption:</h6>
									<p><i><%= image.media_printcaption %></i></p>
								</div>
							<% end %>
							<div class="modal_image_caption">
								<h6>Image Details:</h6>
								<p>
									Image Size: <%= (image.media_width*1.0/72 * 100).floor / 100.0 %> x 
										<%= (image.media_height*1.0/72 * 100).floor / 100.0%> inches<br>
									Media Type: <%= image.media_type %><br>
								</p>
							</div>
							<div class=""><br></div>
							<h6>Purchase Digital Download:</h6>
							<div class="purchase_bar">
								<% @default_settings.default_pricing.each do |price| %>
									<% if price.active and price.item_type == "StoryImage" %>
										<% if (!price.admin_only) or (price.admin_only and admin?) %>
											<span class="purchase_price">
												<%= price.price_name %>
												<a href="#" data-toggle="tooltip" data-original-title="<%= price.price_tooltip %>" data-placement="top">
													<i class="fa fa-info-circle" ></i>
												</a>
												- <%= number_to_currency(price.price) %>
												<br/>
												<% if image_in_cart?(image.id) %>
													<%= link_to "Already in Cart <i class='fa fa-shopping-cart'> </i>".html_safe, cart_path, 
														:class=>"btn btn-success" %>
												<% else %>
													<%= link_to 'Add to cart', 
														cart_path(:id => image, 
																:price => price.price,
																:quality => price.price_quality,
																:description => price.price_description), 
														:method => 'POST', :class=>"btn btn-success" %>
												<% end %>
												<br/>
												<br/>
											</span>
										<% end %>
									<% end %>
								<% end %>
							</div>
						</div>
					</div>
				</div>
				<hr/>
				<div class="container related_image_block">
					<div class="row">
						<% if get_pdf_image(image).present? %>
							<% get_pdf_image(image).each do |pdf| %>
								<div class="col-xs-2 col-sm-2 col-md-2 col-lg-1 reduce_padding text-center">
									<%= pdf.pubdate.strftime('%m/%d/%y') unless pdf.pubdate.nil? %> Publication:
								</div>
								<div class="col-xs-2 col-sm-2 col-md-2 col-lg-1 reduce_padding">
										<%= link_to image_tag(pdf.image(:large), :class=>"related_image_thumbs"), 
										 	pdf_images_path(:pub_select => pdf.plan.pub_name, 
											:date_select => pdf.pubdate.strftime('%m/%d/%Y'), 
											:search_query => "") %>
								</div>
							<% end %>
						<% end %>
						<% if image.story %>
							<% related_count = 0 %>
							<% image.story.story_images.each do |related_image| %>
								<% if related_image.id != image.id and image_for_sale?(related_image,@default_settings) %>
									<% related_count += 1 %>
									<% if related_count == 1 %>
										<div class="col-xs-2 col-sm-2 col-md-2 col-lg-1 reduce_padding text-center">
											Related Images:
										</div>
									<% end %>
									<div class="col-xs-2 col-sm-2 col-md-2 col-lg-1 reduce_padding">
										<%= link_to image_tag(related_image.image(:large), :alt=>"Story Image", :class=>"related_image_thumbs"),
										 	story_image_path(related_image.id) %>
									</div>
								<% end %>
							<% end %>
						<% end %>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<div class="container">
					<div class="image_copyright text-center"> 
						<% if image.story && image.story.plan %>
							&copy; Copyright <%= image.story.pubdate.strftime('%Y') unless image.story.pubdate.nil? %> 
							- <%= image.story.plan.pub_name unless image.story.plan.pub_name.nil? %>
							- The Bulletin/EO Media Group
						<% else %>
							&copy; Copyright - The Bulletin/EO Media Group
						<% end %>
						<span class="float-right"><%= link_to image.id, story_image_path(image.id) %></span>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
