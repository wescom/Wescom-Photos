<% if image.image.url != "/images/no-image.jpg"%>
	<div class="col-xs-12 col-sm-6 col-md-4 col-lg-4 ">
		<div class="image_gallery_panel">
			<div class="crop">
				<%= link_to image_tag(image.image(:large), :alt=>"Story Image", :id=>"#{image.id}", :class=>""), story_image_path(image.id), { 
					:remote => true, 'data-toggle' =>  "modal", 
					'data-target' => "#imageGalleryModal#{image.id}", 
					'data-type' => "html" } %>
				<div class="watermark">&copy; Copyright - Western Communications, Inc.</div>
			</div>

			<div class="image_gallery_caption">
				<% if !image.media_printcaption.nil? %>
					<%= image.media_printcaption %>
				<% end %>
			</div>
		</div>
	</div>
<% end %>


<div class="modal fade" id="imageGalleryModal<%= image.id %>" tabindex="-1" role="dialog" aria-labelledby="gridSystemModalLabel" aria-hidden="true">
	<div class="modal-dialog ">
		<div class="modal-content">
			<div class="modal-header">
				<h4 class="modal-title">
					<% if image.story.plan %>
						<%= image.story.plan.pub_name unless image.story.plan.pub_name.nil? %>
						- <%= image.story.pubdate.strftime('%m/%d/%y') unless image.story.pubdate.nil? %>
					<% end %>
				</h4>
				<button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
			</div>
			<div class="modal-body">
				<div class="container">
					<div class="row">
						<div class="col-md-8 col-lg-8">
							<div class="modal_image2">
								<%= image_tag(image.image(:large), :alt=>"Story Image", :class=>"") %>
								<div class="watermark">&copy; Copyright - Western Communications, Inc.</div>
							</div>
						</div>
						<div class="col-md-4 col-lg-4">
							<% if !image.media_printcaption.nil? %>
								<i>"<%= image.media_printcaption %>"</i>
							<% else %>
								No Caption
							<% end %>
							<br/>
						 	<div class="purchase_bar">
								<div class="row">
									<div class="col-xs-4 col-sm-4 col-md-7 col-lg-7">
										<div class="purchase_price">$9.99</div>
									</div>
									<div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
										<%= link_to 'Add to cart', cart_path(:id => image), :method => 'POST', :class=>"btn btn-success" %>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<div class="container">
					<div class="image_copyright text-center"> 
						<% if image.story.plan %>
							&copy; Copyright <%= image.story.pubdate.strftime('%Y') unless image.story.pubdate.nil? %> 
							- <%= image.story.plan.pub_name unless image.story.plan.pub_name.nil? %>
							- Western Communications, Inc.
						<% else %>
							&copy; Copyright - Western Communications, Inc.
						<% end %>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
