<% if image.image.url != "/images/no-image.jpg"%>
	<div class="image_gallery_panel">
	 	<div class="panel-heading"></div>
	 	<div class="panel-body">
			<%= image_tag(image.image(:large), :alt=>"Story Image", :class=>"image_gallery_size image_gallery_img") %>
			<div class="image_gallery_caption">
				<% if !image.media_printcaption.nil? %>
					<%= image.media_printcaption %>
				<% else %>
					ORIGINAL CAPTION: DO NOT SHOW
				<% end %>
			</div>
	    </div>
	</div>
<% end %>