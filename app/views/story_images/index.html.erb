<div class="image-gallery-search-wrap">
	<div class="image-gallery-search">        
		<%= render :partial => 'search_images' %>
	</div>

</div>

<div class="story_images_block">
	<% if @story_images %>
		<div class="container search_results">
			<div class="search_result_count hidden-sm-down"><i><%= @search_result_count %> results</i></div>
			<div class="search_result_count hidden-md-up"><i><%= @search_result_count %> results</i></div>
			<div class="flickr_pagination hidden-sm-down">
				<%= will_paginate @story_images.results, :inner_window => 2, :outer_window => 0 %>
			</div>
			<div class="flickr_pagination hidden-md-up">
				<%= will_paginate @story_images.results, :inner_window => 2, :outer_window => 0, :page_links => false %>
			</div>
		</div>

		<div id="image-gallery" class="container-fluid">
			<div class="row">
				<%= render :partial => 'image', :collection => @story_images.results, object: @default_settings %>
			</div>
		</div>
		
		<div class="container search_results">
			<div class="search_result_count"><%= @search_result_count %> results</div>
			<div class="flickr_pagination hidden-sm-down">
				<%= will_paginate @story_images.results, :inner_window => 2, :outer_window => 0 %>
			</div>
			<div class="flickr_pagination hidden-md-up">
				<%= will_paginate @story_images.results, :inner_window => 2, :outer_window => 0, :page_links => false %>
			</div>
		</div>
	<% end %>
</div>
