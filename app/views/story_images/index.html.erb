<div id="story_images-page">
	<div id="page-content" class="clearfix">
		<h1>
			Images
		</h1>

		<div class="inner-box clearfix">
		  <div id="form-block" class="grid_15">
			  <% if @story_images %>
			    <div id="table-block" class="grid_15">
						<div id="table-paginate" class="full_width">
			      	<div class="float_right"><%= will_paginate @story_images %></div>
						</div>
			      <% unless @story_images.nil? %>
			        <table cellspacing="0" cellpadding="0">
			          <tbody>
			            <tr class="header">
			              <td>Name</td>
			              <td>Type</td>
			              <td>Location</td>
			              <td>Created</td>
			              <td>Updated</td>
			              <td class="center">Action</td>
			            </tr>
			            <%= render :partial => 'image_fragment', :collection => @story_images %>
			          </tbody>
			        </table>
			      <% end %>
						<div id="table-paginate" class="full_width">
			      	<div class="float_right"><%= will_paginate @story_images %></div>
						</div>
			    </div>
			  <% end %>
			</div>
		</div>
	</div>
</div>