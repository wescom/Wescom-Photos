<h1>Search Images</h1>
<span><%= @search_results.count %> results</span>
<span><%= render :partial => 'search_images' %></span>

<div id="story_images-page">
	<% if @story_images %>
		<div class="container-fluid">
			<div class="row">
				<%= render :partial => 'image_fragment', :collection => @story_images.results %>
			</div>
		</div>
	<% end %>
</div>
