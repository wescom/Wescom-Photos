<h1>Search Images</h1>
<span><%= @search_results.count %> results</span>
<span><%= render :partial => 'search_images' %></span>

<div class="inner-box clearfix">
	<div id="image-block" class="full_width">
		<h3>Click images to view info ...</h3>
		<% if @story_images %>
			<div id="image-gallery" class="container-fluid">
				<%= render :partial => 'image', :collection => @story_images.results %>
			</div>
		<% end %>
	</div>
</div>
