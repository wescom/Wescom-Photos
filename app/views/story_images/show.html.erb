<h4 class="image_heading">
	<% if @story_image.story %>
		<% if @story_image.story.plan %>
			<%= @story_image.story.plan.pub_name unless @story_image.story.plan.pub_name.nil? %>
			- <%= @story_image.story.pubdate.strftime('%m/%d/%y') unless @story_image.story.pubdate.nil? %>
			<% if !@story_image.story.hl1.nil? and @story_image.story.hl1.length > 1 %>
				<%= "- " + @story_image.story.hl1 %>
			<% end %>
		<% else %>
			<%= @story_image.story.hl1 unless @story_image.story.hl1.nil? %>
		<% end %>
	<% end %>
</h4>
<div class="container">
	<div class="row image_block">
		<div class="col-xs-12 col-sm-12 col-md-12 col-lg-8">
			<div class="modal_image2">
				<%= image_tag(@story_image.image(:large), :alt=>"Story Image", :class=>"") %>
				<div class="watermark">&copy; Copyright - Western Communications, Inc.</div>
			</div>
		</div>
		<div class="col-xs-12 col-sm-12 col-md-12 col-lg-4">
			<% if !@story_image.media_webcaption.nil? && @story_image.media_webcaption.length > 1 %>
				<div class="modal_image_caption">
					<h6>Web Caption:</h6>
					<p><i><%= @story_image.media_webcaption %></i></p>
				</div>
			<% end %>
			<% if !@story_image.media_printcaption.nil? && @story_image.media_printcaption.length > 1 %>
				<div class="modal_image_caption">
					<h6>Print Caption:</h6>
					<p><i><%= @story_image.media_printcaption %></i></p>
				</div>
			<% end %>
			<div class=""></div>
			<div class="purchase_bar">
				<span class="purchase_price">Digital Download - <%= number_to_currency(image_price) %></span>
				<span class="purchase_btn">
					<% if image_in_cart?(@story_image.id) %>
						<%= link_to "Already in Cart <i class='fa fa-shopping-cart'> </i>".html_safe, cart_path, 
							:class=>"btn btn-success" %>
					<% else %>
						<%= link_to 'Add to cart', cart_path(:id => @story_image), :method => 'POST', :class=>"btn btn-success" %>
					<% end %>
				</span>
			</div>
		</div>
	</div>
</div>
<br/>
<br/>

<div class="image_related">
	<div class="container">
		<h5>Related items</h5>
		<div class="row">
			<% if !@pdf_images.nil? %>
				<div class="col-6 col-sm-4 col-md-3 col-lg-3">
					<% @pdf_images.each_with_index do |pdf, index| %>
						<div class="card text-center">
							<div class="card-img-top">
								<%= link_to image_tag(pdf.image(:large), :class=>"card_section_img"), 
								 	pdf_images_path(:pub_select => pdf.publication, 
									:date_select => pdf.pubdate.strftime('%m/%d/%Y'), 
									:search_query => "") %>
							</div>
							<div class="card-block">
								<p class="card-text">
									<%= pdf.pubdate.strftime('%m/%d/%y') unless pdf.pubdate.nil? %>
								</p>
								<%= link_to( "Browse", pdf_images_path(:pub_select => pdf.publication, 
									:date_select => pdf.pubdate.strftime('%m/%d/%Y'), 
									:search_query => ""),
									:class=>"btn btn-primary") %>
							</div>
						</div>
					<% end %>
				</div>
			<% end %>
			<div class="col-6 col-sm-8 col-md-9 col-lg-9">
				<div class="row">
					<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
						<div class="card text-center">
							<div class="card-block">
								<div class="card-title">
									Search for similar images:
								</div>
								<div class="image-gallery-search-wrap">
									<div class="image-gallery-search">        
										<%= render :partial => 'story_images/search_images' %>
									</div>
								</div>
							</div>
						</div>
					</div>
					<% if !@related_story_images.nil? %>
						<% @related_story_images.each_with_index do |image, index| %>
							<% if image_for_sale?(image) %>
								<div class="col-xs-12 col-sm-6 col-md-6 col-lg-4">
									<div class="card text-center">
										<%= link_to image_tag(image.image(:large), :class=>"card-img-top card_section_img"), story_image_path(image.media_id) %>
										<div class="card-block">
											<p class="card-text">
												<% if !image.media_webcaption.nil? and !image.media_webcaption.empty? %>
													<i class="modal_image_caption"><%= truncate image.media_webcaption, :length => 60, :separator => /\s/ %></i>
												<% else %>
													<i class="modal_image_caption"><%= truncate image.media_printcaption, :length => 60, :separator => /\s/ %></i>
												<% end %>
											</p>
											<%= link_to( "View", story_image_path(image.media_id), :class=>"btn btn-primary") %>
										</div>
									</div>
								</div>
							<% end %>
						<% end %>
					<% end %>
				</div>
			</div>
		</div>
	</div>
</div>
	
