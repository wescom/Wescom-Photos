<div class="image-gallery-search-wrap">
	<div class="image-gallery-search">        
		<%= render :partial => 'search_images' %>
	</div>

</div>

<h4 class="image_heading">
	<% if @story_image.story %>
		<% if @story_image.story.plan %>
			<%= @story_image.story.plan.pub_name unless @story_image.story.plan.pub_name.nil? %>
			- <%= @story_image.story.pubdate.strftime('%m/%d/%y') unless @story_image.story.pubdate.nil? %>
			<% if !@story_image.story.hl1.nil? and @story_image.story.hl1.length > 1 %>
				<%= "- " + @story_image.story.hl1 %>
			<% end %>
		<% else %>
			<%= @story_image.story.hl1 unless @story_image.story.hl1.nil? %>
		<% end %>
	<% end %>
</h4>
<div class="container">
	<div class="row image_block">
		<div class="col-xs-12 col-sm-12 col-md-12 col-lg-8">
			<div class="modal_image2">
				<%= image_tag(@story_image.image(:large), :alt=>"Story Image", :class=>"") %>
				<div class="watermark">&copy; Copyright - Western Communications, Inc.</div>
			</div>
		</div>
		<div class="col-xs-12 col-sm-12 col-md-12 col-lg-4">
			<% if !@story_image.media_webcaption.nil? && @story_image.media_webcaption.length > 1 %>
				<div class="modal_image_caption">
					<h6>Web Caption:</h6>
					<p><i><%= @story_image.media_webcaption %></i></p>
				</div>
			<% end %>
			<% if !@story_image.media_printcaption.nil? && @story_image.media_printcaption.length > 1 %>
				<div class="modal_image_caption">
					<h6>Print Caption:</h6>
					<p><i><%= @story_image.media_printcaption %></i></p>
				</div>
			<% end %>
			<div class="modal_image_caption">
				<h6>Image Details:</h6>
				<p>
					Image Size: <%= (@story_image.media_width*1.0/72 * 100).floor / 100.0 %> x <%= (@story_image.media_height*1.0/72 * 100).floor / 100.0%> inches<br>
					Media Type: <%= @story_image.media_type %><br>
				</p>
			</div>
			<div class=""><br></div>
			<h6>Purchase Digital Download:</h6>
			<div class="purchase_bar">
				<span class="purchase_price">
					High Resolution - <%= number_to_currency(@default_settings.image_hi_res_price) %>
					<% if image_in_cart?(@story_image.id) %>
						<%= link_to "Already in Cart <i class='fa fa-shopping-cart'> </i>".html_safe, cart_path, 
							:class=>"btn btn-success" %>
					<% else %>
						<%= link_to 'Add to cart', 
							cart_path(:id => @story_image, 
									:price => @default_settings.image_hi_res_price,
									:quality => "Hires",
									:description => "High Resolution Image Download"), 
							:method => 'POST', :class=>"btn btn-success" %>
					<% end %>
					<br/>
				</span>
				<span class="purchase_price">
					Low Resolution - <%= number_to_currency(@default_settings.image_low_res_price) %>
					<% if image_in_cart?(@story_image.id) %>
						<%= link_to "Already in Cart <i class='fa fa-shopping-cart'> </i>".html_safe, cart_path, 
							:class=>"btn btn-success" %>
					<% else %>
						<%= link_to 'Add to cart', 
							cart_path(:id => @story_image, 
									:price => @default_settings.image_low_res_price,
									:quality => "Lowres",
									:description => "Low Resolution Image Download"), 
							:method => 'POST', :class=>"btn btn-success" %>
					<% end %>
					<br/>
				</span>
			</div>
		</div>
	</div>
</div>
<br/>
<br/>

<div class="image_related">
	<div class="container">
		<h5>Related items</h5>
		<div class="row">
			<% if !@pdf_images.nil? %>
				<div class="col-6 col-sm-4 col-md-3 col-lg-3">
					<% @pdf_images.each_with_index do |pdf, index| %>
						<div class="card text-center">
							<div class="card-img-top">
								<%= link_to image_tag(pdf.image(:large), :class=>"card_section_img"), 
								 	pdf_images_path(:pub_select => pdf.plan.pub_name, 
									:date_select => pdf.pubdate.strftime('%m/%d/%Y'), 
									:search_query => "") %>
							</div>
							<div class="card-block">
								<p class="card-text">
									<%= pdf.pubdate.strftime('%m/%d/%y') unless pdf.pubdate.nil? %>
								</p>
								<%= link_to( "Browse", pdf_images_path(:pub_select => pdf.publication, 
									:date_select => pdf.pubdate.strftime('%m/%d/%Y'), 
									:search_query => ""),
									:class=>"btn btn-primary") %>
							</div>
						</div>
					<% end %>
				</div>
			<% end %>
			<div class="col-6 col-sm-8 col-md-9 col-lg-9">
				<div class="row">
					<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
						<div class="card text-center">
							<div class="card-block">
								<div class="card-title">
									Search for similar images:
								</div>
								<div class="image-gallery-search-wrap">
									<div class="image-gallery-search">        
										<%= render :partial => 'story_images/search_images' %>
									</div>
								</div>
							</div>
						</div>
					</div>
					<% if !@related_story_images.nil? %>
						<% @related_story_images.each_with_index do |image, index| %>
								<div class="col-xs-12 col-sm-6 col-md-6 col-lg-4">
									<div class="card text-center">
										<%= link_to image_tag(image.image(:large), :class=>"card-img-top card_section_img"), story_image_path(image.id) %>
										<div class="card-block">
											<p class="card-text">
												<% if !image.media_webcaption.nil? and !image.media_webcaption.empty? %>
													<i class="modal_image_caption"><%= truncate image.media_webcaption, :length => 60, :separator => /\s/ %></i>
												<% else %>
													<i class="modal_image_caption"><%= truncate image.media_printcaption, :length => 60, :separator => /\s/ %></i>
												<% end %>
											</p>
											<%= link_to( "View", story_image_path(image.id), :class=>"btn btn-primary") %>
										</div>
									</div>
								</div>
						<% end %>
					<% end %>
				</div>
			</div>
		</div>
	</div>
</div>
	
<% if admin? %>
	<br/>
	<div class="card">
		<div class="card-block">
			<div class="card-header">
				<button class="btn btn-secondary image_admin_info_toggle">
					<i class="fa fa-info" ></i>
				</button>
				Admin Info:
			</div>
			<div class="image_admin_info card-block">
				<p><strong>Original caption</strong> - <i><%= @story_image.media_originalcaption.to_s unless @story_image.media_originalcaption.nil? %></i></p>
				<p><strong>ID</strong> - <i><%= @story_image.id unless @story_image.id.nil? %></i></p>
				<p><strong>Media ID</strong> - <i><%= @story_image.media_id unless @story_image.media_id.nil? %></i></p>
				<p><strong>Media Name</strong> - <i><%= @story_image.media_name unless @story_image.media_name.nil? %></i></p>
				<p><strong>Original Filename</strong> - <i><%= @story_image.image_file_name unless @story_image.image_file_name.nil? %></i></p>
				<p><strong>Project Group</strong> - <i><%= @story_image.media_project_group unless @story_image.media_project_group.nil? %></i></p>
				<p><strong>Image Size</strong> - <i><%= @story_image.media_width %> x <%= @story_image.media_height %> pixels, 
					<%= (@story_image.media_width*1.0/72 * 100).floor / 100.0 %> x <%= (@story_image.media_height*1.0/72 * 100).floor / 100.0%> inches</i></p>
				<p><strong>Status</strong> - <i><%= @story_image.media_status unless @story_image.media_status.nil? %></i></p>
				<p><strong>Priority (web status)</strong> - <i><%= @story_image.priority unless @story_image.priority.nil? %></i></p>
				<p><strong>Type</strong> - <i><%= @story_image.image_content_type unless @story_image.image_content_type.nil?%></i></p>
				<p><strong>Created</strong> - <i><%= @story_image.created_date.strftime('%m/%d/%y %I:%M%p') unless @story_image.created_date.nil? %></i></p>
				<p><strong>Last Refreshed</strong> - 
					<i><%= @story_image.last_refreshed_time.strftime('%m/%d/%y %I:%M%p') unless @story_image.last_refreshed_time.nil? %></i></p>

				<p><strong>Story Id</strong> - <i><%= @story_image.story.id unless @story_image.story.nil?%></i></p>
				<p><strong>Story Name</strong> - <i><%= @story_image.story.doc_name unless @story_image.story.nil?%></i></p>
				<p><strong>Story Headline</strong> - <i><%= @story_image.story.hl1 unless @story_image.story.nil?%></i></p>
				<p><strong>Story Category</strong> - <i><%= @story_image.story.categoryname unless @story_image.story.nil?%></i></p>
				<p><strong>Story SubCategory</strong> - <i><%= @story_image.story.subcategoryname unless @story_image.story.nil?%></i></p>
				<p><strong>Image For Sale (ignore search filters)</strong> - <%= @story_image.forsale unless @story_image.forsale.nil?%>
					<div class="indent">
						<%= form_tag story_image_approve_forsale_path(@story_image.id), :method => :put do %>
							<%= select_tag "forsale", options_for_select(StoryImage::FORSALE_OPTIONS, :selected=>@story_image.forsale) %>
							<%= submit_tag "Save", :class => 'submit btn btn-sm'%>
						<% end %>
					</div>
				</p>
				<div class="change_log">
					<div class="change_log_header">Image Change Log:</div>
					<% @story_image.logs.reverse_each do |log| %>
						<div>
							<%= log.created_at.in_time_zone("Pacific Time (US & Canada)").strftime('%m/%d/%y %I:%M%p') %> - 
							<%= log.log_detail %>
							by <%= log.user.name unless log.user.nil? %>
						</div>
					<% end %>
				</div>
			</div>
		</div>
	</div>
<% end %>
