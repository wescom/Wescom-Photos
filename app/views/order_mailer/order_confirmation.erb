<!DOCTYPE html>
<html>
	<head>
		<meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
		<%= stylesheet_link_tag "emails" %>
	</head>
	<body>
		<div class="container">
			<div class="row">
				<br/>
		    	<h2>Your Order has been processed</h2>
				<p>
			      Thank you for your order. You can view your order online at <%= link_to @order.id, order_url(@order.obscure_uniq_identifier) %>.
				</p>
				<br/>

				<h4>Order Info</h4>
				<div class="indent">
					<p><strong>Date: </strong><%= @order.created_at.in_time_zone("Pacific Time (US & Canada)").strftime('%m/%d/%y - %l:%M %P') %></p>
					<p><strong>Name: </strong><%= @order.first_name %> <%= @order.last_name %></p>
					<p><strong>Amount: </strong><%= number_to_currency(@order.amount) %></p>
					<p><strong>Credit card charged: </strong>x<%= @order.last4 %></p>
				</div>
				<br/>

				<h4>Images Purchased</h4>
				<i class="text-muted">Download links for images are <%= link_to 'here', order_url(@order.obscure_uniq_identifier) %></i>
				<div class="indent">
					<ul class="list-unstyled">
						<% @order.order_items.each_with_index do |order_item, index| %>
							<li>
								<span>Item<%= (index+1).to_s %></span>
									<% if order_item.item_type == "StoryImage" %>
										<% if order_item.story_image.story %>
											<% if order_item.story_image.story.plan %>
												<span class="tab">
													<%= order_item.story_image.story.plan.pub_name unless order_item.story_image.story.plan.pub_name.nil? %>
													- <%= order_item.story_image.story.pubdate.strftime('%m/%d/%y') unless order_item.story_image.story.pubdate.nil? %>
												</span>
											<% end %>
										<% end %>
									<% else %>
										<% if order_item.pdf_image.plan %>
											<span class="tab">
												<%= order_item.pdf_image.publication %> - 
												<%= order_item.pdf_image.pubdate.strftime('%m/%d/%y') unless order_item.pdf_image.pubdate.nil? %> - 
												<%= order_item.pdf_image.section_letter %><%= order_item.pdf_image.page %>
											</span>
										<% end %>
									<% end %>
								<span class="tab">
									<%= number_to_currency(order_item.price_cents.to_d/100) %>
								</span>
							</li>
						<% end %>
					</ul>
				</div>

				<br/><br/>
				<p>Please do not reply to this email. If you have any questions or concerns about your order, please contact us at <a href="mailto:info@wescomphotos.com">info@wescomphotos.com</a>. </p>
			</div>
		</div>
	</body>
</html>