<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
  </head>
  <body>
    <h1>Order #<%= @order.id %></h1>
	Date: <%= @order.created_at.strftime('%m/%d/%Y') %><br/>
		<p>
			<table id="order" class="table table-hover table-condensed">
				<thead>
					<tr>
						<th class="image_column text-center">Image</th>
						<th class="publish_column text-center">Published</th>
						<th class="price_column text-center">Price</th>
						<th class="action_column" ></th>
					</tr>
				</thead>

				<tbody>
					<%= render :partial => 'orders/order_item', :collection => @order.order_items %>
				</tbody>

				<tfoot>
					<tr>
						<td colspan="1"></td>
						<td class="float-right"><strong>Total:</strong></td>
						<td class="text-center"><strong><%= number_to_currency @order.amount %></strong></td>
					</tr>
				</tfoot>
			</table>
		</p>
		<br/>
		<p>Please do not reply to this email.</p>
  </body>
</html>