<% if @default_settings_list %>
	<!-- No subdomain location given, display a list to choose from -->
	<div class="publication_head">
		<h3 class="">Choose from our Publications</h3>
	</div>
	<div class="publication_block">
		<div class="d-flex justify-content-center flex-wrap">
			<% @default_settings_list.each do |default_setting| %>
					<div class="publication_banner d-flex align-items-center justify-content-center">
						<% default_setting.default_banner_images.order("RAND()").limit(1).each do |image| %>
							<%= image_tag(image.banner_image(:medium), :class=>"publication_banner_img") unless image.nil? %>
						<% end %>
						<div class="publication_logo d-flex align-items-center justify-content-center">
							<%= link_to image_tag(default_setting.site_image(:medium), 
								:alt=>default_setting.location.newspaper_name, 
								:class=>"publication_logo_img"), 
								"https://"+default_setting.location.short_url_newspaper_name+".wescomphotos.com" %>
						</div>
					</div>
			<% end %>
		</div>
	</div>
<% else %>
	<!-- Display Home page for current location -->
	<br/>
	<div class="home-page-head">
		<% if !@banner_image.nil? %>
			<%= image_tag(@banner_image.banner_image(:large), :class=>"") unless @banner_image.nil? %>
		<% end %>
	    <div class="banner-search-wrap">
			<h1>Welcome to WescomPhotos.com</h1>
			<div class="header-search">        
				<%= render :partial => 'story_images/search_images' %>
			</div>
		</div>
	</div>

	<div class="home-page-info">
		<div class="text-center">
			<%= @default_settings.home_welcome_text.html_safe %>
		</div>
	</div>

	<div class="home-page-info">
		<h3 class="">Popular Image Categories</h3>
		<div class="container">
			<div class="row">
				<div class="col-xs-12 col-sm-6 col-md-4 col-lg-4">
					<div class="card text-center">
						<%= link_to image_tag(@cat1_image.image(:large), 
							:alt=>default_setting.location.newspaper_name+" "+@default_settings.home_image_cat1_name.titlecase+" photos", 
							:class=>"card-img-top card_section_img"), 
							story_images_path(:search_query => @default_settings.home_image_cat1) unless @cat1_image.nil? %>
						<div class="card-block">
							<h4 class="card-title"><%= @default_settings.home_image_cat1_name.titlecase.html_safe %></h4>
							<p class="card-text"><%= @default_settings.home_image_cat1_description.html_safe %></p>
							<%= link_to( "Browse", story_images_path(:search_query => @default_settings.home_image_cat1), :class=>"btn btn-primary") %>
						</div>
					</div>
				</div>
				<div class="col-xs-12 col-sm-6 col-md-4 col-lg-4">
					<div class="card text-center">
						<%= link_to image_tag(@cat2_image.image(:large), 
							:alt=>default_setting.location.newspaper_name+" "+@default_settings.home_image_cat1_name.titlecase+" photos", 
							:class=>"card-img-top card_section_img"), 
							story_images_path(:search_query => @default_settings.home_image_cat2) unless @cat2_image.nil?  %>
						<div class="card-block">
							<h4 class="card-title"><%= @default_settings.home_image_cat2_name.titlecase.html_safe %></h4>
							<p class="card-text"><%= @default_settings.home_image_cat2_description.html_safe %></p>
							<%= link_to( "Browse", story_images_path(:search_query => @default_settings.home_image_cat2), :class=>"btn btn-primary") %>
						</div>
					</div>
				</div>
				<div class="col-xs-12 col-sm-6 col-md-4 col-lg-4 d-none d-md-block">
					<div class="card text-center">
						<%= link_to image_tag(@cat3_image.image(:large), 
							:alt=>default_setting.location.newspaper_name+" "+@default_settings.home_image_cat1_name.titlecase+" photos", 
							:class=>"card-img-top card_section_img"), 
							story_images_path(:search_query => @default_settings.home_image_cat3) unless @cat3_image.nil?  %>
						<div class="card-block">
							<h4 class="card-title"><%= @default_settings.home_image_cat3_name.titlecase.html_safe %></h4>
							<p class="card-text"><%= @default_settings.home_image_cat3_description.html_safe %></p>
							<%= link_to( "Browse", story_images_path(:search_query => @default_settings.home_image_cat3), :class=>"btn btn-primary") %>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<% if @pdf_images.count > 0 %>
		<div class="home-page-info">
			<h3 class="">Order PDFs of pages</h3>
			<div class="container">
				<div class="row">
					<% @pdf_images.each_with_index do |pdf, index| %>
						<!-- limit number of PDFs based on screen size -->
						<% case index+1 %>	
						<% when 1 %>
							<div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
						<% when 2 %>
							<div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
						<% when 3 %>
							<div class="col-xs-12 col-sm-6 col-md-4 col-lg-3 d-none d-md-block">
						<% when 4 %>
							<div class="col-xs-12 col-sm-6 col-md-4 col-lg-3 d-none d-lg-block">
						<% end %>
							<div class="card text-center">
								<%= link_to image_tag(pdf.image(:large), :class=>"card-img-top card_pdf_image"), 
								 	pdf_images_path(:pub_select => pdf.publication, 
									:date_select => pdf.pubdate.strftime('%m/%d/%Y'), 
									:search_query => "") %>
								<div class="card-block">
									<p class="card-text">
										<%= pdf.pubdate.strftime('%m/%d/%y') unless pdf.pubdate.nil? %>
									</p>
									<%= link_to( "Browse", pdf_images_path(:pub_select => pdf.publication, 
										:date_select => pdf.pubdate.strftime('%m/%d/%Y'), 
										:search_query => ""),
										:class=>"btn btn-primary") %>
								</div>
							</div>
						</div>
					<% end %>
				</div>
			</div>
			<br/>
			<%= link_to( "Search all publication dates", pdf_images_path(:search_query => ""), :class=>"btn btn-primary") %>
		</div>
	<% end %>
<% end %>