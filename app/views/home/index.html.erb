<br/>
<%= @main_image.id %>
<div class="home-page-head">
	<%= image_tag(@main_image.image(:original), :class=>"") unless @main_image.nil? %>
    <div class="banner-search-wrap">
		<div class="container">
			<div class="row">
				<h1>Welcome to WescomPhotos.com</h1>
				<div class="header-search">        
					<%= render :partial => 'story_images/search_images' %>
				</div>
			</div>
		</div>
	</div>
</div>

<div class="home-page-info">
	<div class="text-center">
		<%= @default_settings.home_welcome_text %>
	</div>
</div>

<div class="home-page-info">
	<h3 class="">Popular Categories</h3>
	<div class="container">
		<div class="row">
			<div class="col-xs-12 col-sm-6 col-md-4 col-lg-4">
				<div class="card text-center">
					<%= link_to image_tag(@cat1_image.image(:large), :class=>"card-img-top"), 
						story_images_path(:search_query => @default_settings.home_image_cat1) unless @cat1_image.nil? %>
					<div class="card-block">
						<h4 class="card-title"><%= @default_settings.home_image_cat1_name.titlecase %></h4>
						<p class="card-text"><%= @default_settings.home_image_cat1_description %></p>
						<%= link_to( "Browse", story_images_path(:search_query => @default_settings.home_image_cat1), :class=>"btn btn-primary") %>
					</div>
				</div>
			</div>
			<div class="col-xs-12 col-sm-6 col-md-4 col-lg-4">
				<div class="card text-center">
					<%= link_to image_tag(@cat2_image.image(:large), :class=>"card-img-top"), 
						story_images_path(:search_query => @default_settings.home_image_cat2) unless @cat2_image.nil?  %>
					<div class="card-block">
						<h4 class="card-title"><%= @default_settings.home_image_cat2_name.titlecase %></h4>
						<p class="card-text"><%= @default_settings.home_image_cat2_description %></p>
						<%= link_to( "Browse", story_images_path(:search_query => @default_settings.home_image_cat2), :class=>"btn btn-primary") %>
					</div>
				</div>
			</div>
			<div class="col-xs-12 col-sm-6 col-md-4 col-lg-4">
				<div class="card text-center">
					<%= link_to image_tag(@cat3_image.image(:large), :class=>"card-img-top"), 
						story_images_path(:search_query => @default_settings.home_image_cat3) unless @cat3_image.nil?  %>
					<div class="card-block">
						<h4 class="card-title"><%= @default_settings.home_image_cat3_name.titlecase %></h4>
						<p class="card-text"><%= @default_settings.home_image_cat3_description %></p>
						<%= link_to( "Browse", story_images_path(:search_query => @default_settings.home_image_cat3), :class=>"btn btn-primary") %>
					</div>
				</div>
			</div>
			
		</div>
	</div>
</div>